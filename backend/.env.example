# =================================================================
# FARMER PROCUREMENT MANAGEMENT PLATFORM - PRODUCTION BACKEND CONFIG
# =================================================================

# Server Port (Auto-assigned by cloud platforms like Render / Railway / AWS)
PORT=3000

# Environment (development | staging | production)
NODE_ENV=production

# Public API Gateway Base URL (Replace with your actual HTTPS deployment URL)
# Example: https://farmer-procurement-api.onrender.com/api/v1
API_BASE_URL=https://<your-backend-app-name>.onrender.com/api/v1

# PostgreSQL Database Connection String
# Example: postgresql://procurement_user:your_secure_password@dpg-xxxxxx-a.render.com/farmer_procurement_db
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require

# Security: Production JWT Secret (MANDATORY in production)
# Must be a long random string (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=YOUR_SECURE_PRODUCTION_JWT_SECRET_STRING_HERE

# Security: Configurable CORS Origins (Comma-separated URLs or '*' for open access)
CORS_ORIGIN=*

# Optional Third-Party Government Service Adapters (Leave empty for fallback mode)
GOVERNMENT_API_BASE_URL=
GOVERNMENT_API_KEY=
MAPS_API_KEY=
